# Azure Speech Services (required — get key from https://azure.microsoft.com/en-us/services/cognitive-services/speech-to-text/)
AZURE_SPEECH_REGION=norwayeast
AZURE_SPEECH_ENDPOINT=https://norwayeast.api.cognitive.microsoft.com/
AZURE_SPEECH_KEY=

# DeepSeek for AI correction (recommended — get key from https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Voice language (fi-FI, zh-CN, sv-SE, en-US)
VOICE_LANGUAGE=fi-FI

# Recording duration in seconds
RECORD_DURATION=10

# Microphone device index (run: ffmpeg -f avfoundation -list_devices true -i "" to check)
# :0 = default, :1 = MacBook Air Microphone
MIC_DEVICE=:1
